{
  "manifest_version": 3,
  "name": "Gemini Extended Suite",
  "version": "1.3.1",
  "description": "Gemini Web UI向け作業支援ブラウザ拡張機能（フォルダ整理、MDエクスポート、公式使用状況同期、目次ジャンプ等）",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Gemini Extended Suite 設定"
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "permissions": [
    "storage",
    "notifications",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "css": [
        "content/styles/main.css",
        "content/styles/components.css",
        "content/styles/injected_theme.css"
      ],
      "js": [
        "content/dom_observer.js",
        "content/modules/sidebar_folders.js",
        "content/modules/exporter_md.js",
        "content/modules/usage_monitor.js",
        "content/modules/chat_enhancer.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content/styles/*"
      ],
      "matches": [
        "https://gemini.google.com/*"
      ]
    }
  ]
}
